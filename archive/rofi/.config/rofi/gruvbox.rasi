* {
    /* --- GRUVBOX DARK HARD PALETTE --- */
    bg-col: #282828;       /* gruvbox_bg: main dark background */
    bg-col-light: #3c3836; /* gruvbox_bg1: slightly lighter background, for distinction */
    border-col: #1d2021;   /* gruvbox_bg_hard: very dark, almost black for borders */
    selected-col: #504945; /* gruvbox_bg2: for selected item background, distinct from bg-col */
    blue: #458588;         /* gruvbox_blue: for primary accent/blue elements */
    fg-col: #ebdbb2;       /* gruvbox_fg: main foreground text color */
    fg-col2: #d79921;      /* GRUVBOX_YELLOW: Warna aksen sekunder sekarang kuning */
    grey: #a89984;         /* gruvbox_gray: for subtle text/elements */

    /* --- GLOBAL SETTINGS --- */
    width: 600;
    font: "CaskaydiaCove Nerd Font 12"; /* Pastikan font ini terinstal dan mendukung ikon */
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color: inherit;
}

window {
    height: 360px;
    border: 3px;
    border-color: @border-col;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    background-color: @blue; /* Aksen biru untuk background prompt */
    padding: 6px;
    text-color: @bg-col; /* Teks di prompt akan kontras dengan background biru prompt */
    border-radius: 3px;
    margin: 20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @fg-col;
    background-color: @bg-col;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 10px 0px 0px 20px;
    columns: 2;
    lines: 5;
    background-color: @bg-col;
}

element {
    padding: 5px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element-icon {
    size: 25px;
}

element selected {
    background-color: @selected-col; /* Latar belakang item yang dipilih */
    text-color: @fg-col2; /* TEKS ITEM YANG DIPILIH SEKARANG AKAN KUNING */
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 20px 0px 0px 20px;
    text-color: @blue;
    background-color: @bg-col-light;
}
