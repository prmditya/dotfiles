// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "copilot_chat": {
      "api_url": "https://api.githubcopilot.com/chat/completions",
      "auth_url": "https://api.github.com/copilot_internal/v2/token",
      "models_url": "https://api.githubcopilot.com/models"
    }
  },
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-3.7-sonnet"
    },
    "version": "2"
  },
  "project_panel": {
    "dock": "right"
  },
  "icon_theme": "Material Icon Theme",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 16.0,
  "buffer_font_weight": 600,
  "buffer_line_height": {
    "custom": 1.4
  },

  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Gruvbox Dark Soft"
  },

  "ui_font_family": "CaskaydiaCove Nerd Font Propo",
  "buffer_font_family": "CaskaydiaCove Nerd Font Propo",
  "relative_line_numbers": true
}
