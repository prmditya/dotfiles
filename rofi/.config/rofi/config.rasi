configuration{
  font: "CaskaydiaCove Nerd Font 12";
  modi: "run,window,combi";
  icon-theme: "Oranchelo";
  show-icons: true;
  terminal: "wezterm";
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: false;
  hide-scrollbar: true;
  display-combi: " All ";
  display-run: " Run ";
  display-window: " Window ";
  sidebar-mode: true;
}

@theme "colors-rofi-dark"
