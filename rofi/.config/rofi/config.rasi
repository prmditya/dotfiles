configuration{
  modi: "drun,window,run";
  font: "CaskaydiaCove Nerd Font 12";
  icon-theme: "Oranchelo";
  show-icons: true;
  terminal: "ghostty";
  drun-display-format: "{icon} {name}";
  location: 0;
  disable-history: false;
  hide-scrollbar: true;
  sidebar-mode: true;
  display-clipboard: "Clipboard ";
}

@theme "colors-rofi-dark"
