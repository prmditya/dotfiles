# Sway config file (v1) - Converted from i3 config
#
# Please see https://swaywm.org/docs/manpages/sway.5 for a complete reference!

for_window [class="^.*"] border pixel 1
for_window [class="pavucontrol"] floating enable

gaps inner 10

set $mod Mod4
# set $mod Mod1

# --- X11-specific executables removed or replaced ---
# picom is an X11 compositor, it won't work on Wayland.
# Transparency for Xwayland apps is handled by Sway. For native Wayland apps,
# they need to support it (e.g., wezterm).
# exec --no-startup-id picom --config ~/.config/picom.conf

# feh is for X11. Sway has a built-in wallpaper command.
# exec --no-startup-id feh --bg-scale ~/Pictures/Wallpapers/mbeek.jpg
output * bg ~/Pictures/Wallpapers/mbeek.jpg fill

# xrdb is for X11 resources. Wayland applications do not use this.
# You will need to configure colors/fonts directly for Wayland-native apps
# or via GTK/Qt theme settings.
# exec --no-startup-id xrdb -merge ~/.Xresources

# redshift is X11. Use wlsunset or gammastep for Wayland.
# sudo pacman -S wlsunset
# exec --no-startup-id redshift -c ~/.config/redshift/redshift.conf
exec --no-startup-id wlsunset --temp 5000 --transition 1 --latitude -7.4475 --longitude 112.7153

# setxkbmap is for X11. Use Sway's 'input' command for keyboard options.
# exec_always --no-startup-id setxkbmap -option ctrl:nocaps
input * xkb_options ctrl:nocaps

# polybar is X11. We'll use waybar for Wayland.
# The `exec_always killall polybar` and `launch_polybar.sh` lines will be replaced by the Waybar setup.
# exec_always killall polybar
# exec_always --no-startup-id $HOME/.config/polybar/launch_polybar.sh

# --- Screenshot tools replacement (maim, xdotool, xclip) ---
# Use grim (full screen/window) and slurp (selection) for screenshots, and wl-clipboard for clipboard.
# Install: sudo pacman -S grim slurp wl-clipboard
bindsym Print exec grim "/home/$USER/Pictures/Screenshots/$(date).png"
# For active window, grim needs to be combined with something like 'swaymsg -t get_tree' to get window coordinates.
# A simpler approach is to use grim -g "$(swaymsg -t get_tree | jq -r '.. | select(.focused? and .pid? ) | .rect | "\(.x),\(.y) \(.width)x\(.height)"')"
# However, for `xdotool getactivewindow`, there's no direct Wayland equivalent that provides window ID.
# Most people just use grim with slurp to select the window visually or use a script.
# For simplicity, I'm providing the select option.
# If you really need per-window screenshots without selection, you'd need a more complex script.
# bindsym $mod+Print exec maim --window $(xdotool getactivewindow) "/home/$USER/Pictures/Screenshots/$(date).jpg"
bindsym $mod+Print exec grim -g "$(slurp)" "/home/$USER/Pictures/Screenshots/$(date).png"
bindsym Shift+Print exec grim -g "$(slurp)" "/home/$USER/Pictures/Screenshots/$(date).png"

## Clipboard Screenshots
bindsym Ctrl+Print exec grim -o | wl-copy -t image/png
bindsym Ctrl+$mod+Print exec grim -g "$(slurp)" -o | wl-copy -t image/png
bindsym Ctrl+Shift+Print exec grim -g "$(slurp)" -o | wl-copy -t image/png

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
# This font setting is for Sway's built-in bar if you use it. For Waybar, font is set in Waybar config.
font pango:CaskaydiaCove Nerd Font Mono 14

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
# Sway handles XDG autostart directly, so `dex` is usually not needed or recommended.
# exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.
exec --no-startup-id nm-applet

# exec dunst for notification
exec --no-startup-id dunst

# xss-lock is for X11. Replace with swayidle for idle management and swaylock for screen locking.
# You need to update your ~/.config/i3/lock.sh to call swaylock instead of i3lock.
# For example, your lock.sh could just be:
# #!/bin/bash
# swaylock
#
# exec --no-startup-id xss-lock --transfer-sleep-lock -- ~/.config/i3/lock.sh
exec --no-startup-id swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 000000'

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.

# Use pactl to adjust volume in PulseAudio.
# The `$refresh_i3status` is for i3status. Waybar automatically updates.
# set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec wezterm

# kill focused window
bindsym $mod+Shift+q kill

# start rofi (a program launcher)
# Replace rofi with wofi or fuzzel
# Install wofi: sudo pacman -S wofi
bindsym $mod+d exec --no-startup-id wofi --show drun
bindsym $mod+space exec --no-startup-id wofi --show combi
bindsym $mod+Tab exec --no-startup-id wofi --show window

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# focus the parent container
bindsym $mod+a focus parent

# Lock screen
# Use swaylock instead of i3lock.
# Make sure ~/.config/i3/lock.sh is updated to run `swaylock`
bindsym $mod+Shift+BackSpace exec --no-startup-id ~/.config/i3/lock.sh

# Suspend with lock - combine with swaylock and systemctl
# This line still works if your lock.sh handles `swaylock`.
bindsym $mod+Shift+s exec --no-startup-id "systemctl suspend && ~/.config/i3/lock.sh"

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
# Use swaymsg exit for cleaner Wayland exit, instead of i3-nagbar (which uses X11).
bindsym $mod+Shift+e exec "swaymsg exit"

# resize window (you can also use the mouse for that)

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
# This block needs to be entirely reconfigured for Waybar.
# Install Waybar: sudo pacman -S waybar
# Waybar has its own config at ~/.config/waybar/config and ~/.config/waybar/style.css
#
# Here's how you'd tell Sway to use Waybar:
bar {
    position top
    swaybar_command waybar
}
