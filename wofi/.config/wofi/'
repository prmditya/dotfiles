@import url("file:///home/ditya/.config/wofi/colors-waybar.css"); /* change ditya with your user */

/* --- General Wofi Window --- */
window {
  font-family: "CaskaydiaCove Nerd Font Mono";
  font-size: 12px; /* Adjust font size as needed */
  background-color: @background;
  color: @foreground;
  border: 1px solid @color6; /* Border around the entire wofi window */
}

/* --- Input Field --- */
#input {
  background-color: @background;
  color: @foreground;
  border: none;
  padding: 5px 15px;
  margin: 5px;
}

/* --- Inner Scrollable Area (where results are listed) --- */
#outer-box {
  padding: 5px;
  margin: 5px; /* Spacing around the results list */
}

/* --- Each Entry (application/window) --- */
#entry {
  padding: 8px 10px;
  margin: 2px 0;
}

/* --- Selected/Active Entry --- */
#entry:selected {
  background-color: @color8; /* Accent color for selection */
  color: @color6; /* Text color for selected item */
}

/* --- Icons in Entries --- */
#entry image {
  margin-right: 10px;
  margin-left: 5px;
  width: 5px;
}

/* --- Scrollbar --- */
#scroll {
  /* Since hide_scroll=true, this might not be visible. */
  /* If you change hide_scroll=false, you can style it here. */
}

/* --- Mode Buttons (for sidebar mode) --- */
#mode-box {
  background-color: @background;
  border-right: 1px solid @background; /* Separator for sidebar */
}

#mode-box button {
  padding: 10px 15px;
  margin: 0 0 2px 0;
  color: @gruv_fg;
  border: none;
}

#mode-box button:selected {
  background-color: @color6; /* Selected mode button */
  color: @background;
  border-left: 3px solid @color6; /* Highlight for active mode */
}
