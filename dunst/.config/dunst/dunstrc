#
# Dunst - Minimal Gruvbox Configuration (Fixed Version)
# Save as: ~/.config/dunst/dunstrc
# Reload: dunstctl reload  OR  killall dunst && dunst &
#

[global]
    follow = keyboard
    offset = (10, 10)

    font = CaskaydiaCove Nerd Font 10

    format = "<b>%s</b>\n%b"
    show_age_threshold = 60
    browser = zen-browser

    timeout = 5s

[urgency_low]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#282828"
    timeout = 3s

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#3c3836"
    timeout = 5s

[urgency_critical]
    background = "#cc241d"
    foreground = "#fbf1c7"
    frame_color = "#458588"
    timeout = 999999s
