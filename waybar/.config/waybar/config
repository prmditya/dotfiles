{
    "layer": "top",
    "position": "top",
    "height": 10,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["temperature", "wireplumber", "backlight",  "battery", "tray"],

    "hyprland/window": {
        "format": "󰣇 {title}",
        "max-length": 50,
        "tooltip": true
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": "",
            "urgent": "",
        },
        "persistent-workspaces": {
            "*": [ 1,2,3,4 ]
        }
    },

    "clock": {
        "format": "{:%a %d %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "weeks-pos"     : "right",
                    "on-click-right": "mode",
                    "format": {
                              "months":     "<span><b>{}</b></span>",
                              "days":       "<span><b>{}</b></span>",
                              "weeks":      "<span><b>W{}</b></span>",
                              "weekdays":   "<span><b>{}</b></span>",
                              "today":      "<span><b><u>{}</u></b></span>"
                              }
                    },
        "actions":  {
                    "on-click-right": "mode",
                    "on-click-forward": "tz_up",
                    "on-click-backward": "tz_down",
                    "on-scroll-up": "shift_up",
                    "on-scroll-down": "shift_down"
                    },
    },

    "wireplumber": {
        "format": "\udb81\udd7e {volume}%",
        "max-volume": 100,
        "scroll-step": 5
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "{icon} {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "backlight": {
        "format": "\udb80\udcdf {percent}%",
        "scroll-step": 5
    },

    "temperature": {
        "format": " {temperatureC}°C"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 7
    }
}
