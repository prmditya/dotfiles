{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 5,

    "modules-left": ["hyprland/workspaces", "custom/separator", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["temperature", "custom/separator", "wireplumber", "custom/separator", "backlight", "custom/separator", "battery", "custom/separator", "tray"],

    "custom/separator": {
        "format": " | ",
        "tooltip": false,
        "class": "separator"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "tooltip": true
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": {},
            "2": {},
            "3": {},
            "4": {},
        }
    },

    "clock": {
        "format": "{:%a %m, %H:%M}"
    },

    "wireplumber": {
        "format": "\udb81\udd7e {volume}%",
        "max-volume": 100,
        "scroll-step": 5
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "format": "{icon} {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "backlight": {
        "format": "\udb80\udcdf {percent}%",
        "scroll-step": 5
    },

    "temperature": {
        "format": " {temperatureC}°C"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 7
    }
}
